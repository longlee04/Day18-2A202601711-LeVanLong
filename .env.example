# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
#
# Mọi provider dưới đây đều dùng API tương thích OpenAI — đổi provider chỉ cần
# đổi LLM_PROVIDER + điền key tương ứng, không phải sửa code.

LLM_PROVIDER=groq          # groq | gemini | cerebras | openrouter | openai

# --- Chọn 1 key theo LLM_PROVIDER ở trên ---
GROQ_API_KEY=gsk_...           # https://console.groq.com/keys      (free: 200k token/ngày/model)
# GEMINI_API_KEY=...           # https://aistudio.google.com/apikey (free tier rộng nhất)
# CEREBRAS_API_KEY=csk-...     # https://cloud.cerebras.ai          (free, rất nhanh)
# OPENROUTER_API_KEY=sk-or-... # https://openrouter.ai/keys
# OPENAI_API_KEY=sk-...        # trả phí

# --- Optional overrides ---
# LLM_MODEL=...              # ghi đè model mặc định của provider
# LLM_BASE_URL=...           # ghi đè endpoint
# LLM_MAX_RETRIES=8          # số lần retry khi bị 429
# ENRICH_WITH_LLM=0          # 0 = M5 dùng fallback offline, tiết kiệm quota cho M4
# MODEL_DEVICE=cpu           # cpu | cuda (cuda cần >5GB VRAM cho 3 model)
