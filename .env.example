# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)

# Groq (mặc định) — OpenAI-compatible API, lấy key tại https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional overrides
# LLM_PROVIDER=groq                 # groq | openai
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Chỉ cần khi LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
